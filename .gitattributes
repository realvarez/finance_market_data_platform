# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force LF on shell scripts and config files
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
Dockerfile* text eol=lf
