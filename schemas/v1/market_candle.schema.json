{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_candle.schema.json",
  "title": "MarketCandle",
  "type": "object",
  "required": [
    "event_id", "symbol", "interval", "timestamp",
    "open", "high", "low", "close", "volume", "source", "created_at"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "interval": { "type": "string", "enum": ["1m", "5m", "15m", "30m", "1h", "1d"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "open": { "type": "number", "minimum": 0 },
    "high": { "type": "number", "minimum": 0 },
    "low": { "type": "number", "minimum": 0 },
    "close": { "type": "number", "minimum": 0 },
    "volume": { "type": "number", "minimum": 0 },
    "source": { "type": "string", "enum": ["yahoo_finance", "spark_streaming", "reconciled"] },
    "created_at": { "type": "string", "format": "date-time" },
    "reconciliation_status": { "type": "string", "enum": ["matched", "corrected", "calculated_only", "raw_only"] }
  },
  "additionalProperties": false
}
