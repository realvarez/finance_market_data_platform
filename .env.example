# ==============================================================================
# Market Platform Environment Configuration Template
# Copy this file to .env and adjust credentials as needed:
#   cp .env.example .env
# ==============================================================================

# --- MinIO S3 Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- ClickHouse Analytics Database ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=market_platform

# --- Postgres Metadata Database (for Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow Orchestration ---
# Generate a secure key in production with: openssl rand -hex 32
AIRFLOW_SECRET_KEY=developer-secret-key

# --- Ingestion Symbols (comma-separated) ---
SYMBOLS=BTC-USD,NVDA,MSTR,NU,HIMS,MU
